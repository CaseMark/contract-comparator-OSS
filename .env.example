# Case.dev API (required)
# Get your API key at https://console.case.dev
CASEDEV_API_KEY=
CASEDEV_API_URL=https://api.case.dev

# Vercel Blob (required for PDF/DOCX OCR)
# Automatically available when you add Blob storage to your Vercel project
# See: https://vercel.com/docs/storage/vercel-blob
# BLOB_READ_WRITE_TOKEN=
