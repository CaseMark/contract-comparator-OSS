# Database (Neon PostgreSQL)
# DATABASE_URL=

# Authentication (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# OAuth Providers (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# Case.dev SDK (required for contract comparison)
CASEDEV_API_KEY=
CASEDEV_API_URL=https://api.case.dev

# Vercel Blob (required for PDF/DOCX OCR in production)
# Create a blob store in your Vercel project: https://vercel.com/docs/storage/vercel-blob
# The token is automatically available as BLOB_READ_WRITE_TOKEN when deployed to Vercel
# For local development with OCR, you can add the token manually (optional)
# BLOB_READ_WRITE_TOKEN=

# Stripe Payments
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=

# AI (Vercel AI SDK)
# OPENAI_API_KEY=